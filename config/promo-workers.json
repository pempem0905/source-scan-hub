{
  "schema_version": 2,
  "project": "PROMO_MASTER",
  "project_id": "PROMO-GPT-PIPELINE-V1",
  "purpose": "Version-controlled mirror of the ChatGPT PROMO worker architecture. Canonical PROMO transaction state remains in the live durable writer; canonical source input is published by PROMO-SRC-HUNTER-V1.",
  "runtime": {
    "scheduler": "ChatGPT Scheduled Tasks + GitHub Actions feed/report schedules",
    "cadence": "hourly core / 15m affiliate feeds",
    "active_workers": 4,
    "paused_workers": ["PROMO Hub + L2 Sync"],
    "canonical_state": "Supabase via Source Scan Hub",
    "source_input": "integration/master_input_sources_v1.jsonl",
    "dispatch_plan": "integration/promo_dispatch_plan_v1.jsonl",
    "l2_shadow_queue": "l2/candidate-queue.jsonl",
    "external_candidate_feeds": [
      "integration/accesstrade_handoff_v1.jsonl",
      "integration/accesstrade_catalog_handoff_v1.jsonl",
      "integration/ecomobi_handoff_v1.jsonl",
      "integration/masoffer_handoff_v1.jsonl"
    ],
    "affiliate_product_feeds": [
      "integration/accesstrade_tiktok_feed.jsonl",
      "integration/accesstrade_datafeeds.jsonl"
    ],
    "value_filter": "ACTIONABLE-VALUE-V2",
    "master_rule": "single-writer",
    "migration_mode": "BRIDGE_SHADOW"
  },
  "workers": [
    {
      "name": "PROMO Banks Shard",
      "state": "ACTIVE",
      "role": "extraction-producer",
      "input_mode": "MASTER_INPUT_CONSUMER",
      "scope": ["BANK_CARD", "PAYMENT_WALLET", "TRAVEL_MOBILITY"],
      "responsibilities": ["consume assigned sources", "read official promo/detail/terms", "normalize actionable economics", "enqueue clean candidates"],
      "broad_source_discovery": false
    },
    {
      "name": "PROMO Retail Shard",
      "state": "ACTIVE",
      "role": "extraction-producer",
      "input_mode": "MASTER_INPUT_CONSUMER",
      "scope": ["RETAIL_ECOMMERCE", "FOOD_BEVERAGE", "LOYALTY_REWARDS", "GENERAL"],
      "responsibilities": ["consume assigned sources", "read official promo/detail/terms", "normalize actionable economics", "enqueue clean candidates"],
      "broad_source_discovery": false
    },
    {
      "name": "PROMO Hub + L2 Sync",
      "state": "PAUSED",
      "role": "legacy-discovery-producer",
      "replacement": ["PROMO-SRC-HUNTER-V1", "PROMO-L2-ROUTER-V1"],
      "pause_reason": "Avoid duplicate discovery and keep one scheduled-task slot for PROMO L2 Login Watch."
    },
    {
      "name": "PROMO Turbo Scan",
      "state": "ACTIVE",
      "role": "single-writer-quality-gate",
      "responsibilities": ["global dedup", "validate READY queue", "validate L2 candidates only after promotion from shadow", "validate affiliate-feed candidates against merchant/official source", "atomic commit", "post-commit verification"],
      "crawl_sources": false
    },
    {
      "name": "PROMO GPT Infra + Commit",
      "state": "ACTIVE",
      "role": "dispatcher-health-relay",
      "responsibilities": ["read master input and dispatch plan", "read external candidate feed manifests", "worker health", "producer-stall detection", "commit-stall detection", "queue relay", "writer verification", "source registry export", "status/dashboard health"],
      "broad_source_discovery": false
    }
  ],
  "support_automations": [
    {
      "name": "PROMO L2 Login Watch",
      "state": "ACTIVE",
      "role": "conditional-auth-alert",
      "source": "l2/auth-status.json",
      "alert_states": ["LOGIN_REQUIRED", "NEEDS_RELOGIN", "PERMISSION_REQUIRED"]
    },
    {
      "name": "PROMO Hourly Telegram Report",
      "state": "ACTIVE",
      "role": "hourly-operations-summary-and-improvement-analysis",
      "cadence": "hourly at minute 05",
      "source": "integration/hourly_summary.json",
      "status": "integration/hourly_report_status.json",
      "delivery": "Telegram via GitHub Actions secrets",
      "includes": ["source growth", "canonical promo/code counters", "AccessTrade campaigns/offers/products/TikTok", "Ecomobi/MasOffer state", "L2 state", "improvement alerts"]
    }
  ],
  "subsystems": {
    "source_hunter": {"project_id": "PROMO-SRC-HUNTER-V1", "role": "only broad source discovery and master-input writer"},
    "l2_router": {"project_id": "PROMO-L2-ROUTER-V1", "role": "hard access lanes and shadow extraction", "production_write": false},
    "accesstrade_feed": {"project_id": "PROMO-ACCESSTRADE-FEED-V2", "role": "affiliate voucher/deal discovery, active promotions, campaign approval telemetry, discounted product datafeeds and TikTok Shop product feed", "candidate_feeds": ["integration/accesstrade_handoff_v1.jsonl", "integration/accesstrade_catalog_handoff_v1.jsonl"], "campaign_status": "integration/accesstrade_campaign_registration_status.json", "product_feeds": ["integration/accesstrade_tiktok_feed.jsonl", "integration/accesstrade_datafeeds.jsonl"], "production_write": false, "verification_required": true},
    "ecomobi_feed": {"project_id": "PROMO-ECOMOBI-FEED-V1", "role": "Ecomobi Passio offer, brand-promotion and product discovery feed", "candidate_feed": "integration/ecomobi_handoff_v1.jsonl", "production_write": false, "verification_required": true},
    "masoffer_feed": {"project_id": "PROMO-MASOFFER-FEED-V1", "role": "MasOffer promotion and coupon discovery feed", "candidate_feed": "integration/masoffer_handoff_v1.jsonl", "production_write": false, "verification_required": true}
  },
  "data_rules": {
    "official_source_first": true,
    "affiliate_feed_requires_official_verification": true,
    "affiliate_links_are_never_primary_evidence": true,
    "affiliate_network_feeds_are_discovery_only": true,
    "child_detail_terms_override_hubs": true,
    "literal_code_requires_exact_visible_contextual_evidence": true,
    "raw_regex_code_match_is_never_a_verified_code": true,
    "dynamic_account_qr_otp_referral_contest_ids_are_not_literal_codes": true,
    "expired_and_non_actionable_offers_are_rejected": true,
    "global_dedup_required": true,
    "new_source_discovered_downstream_is_returned_as_SOURCE_CANDIDATE": true
  },
  "sync_note": "Do not hard-code live batch counters here. Worker prompt changes should remain consistent with this mirror. Never store API keys, passwords, cookies, OTPs or refresh tokens in GitHub."
}
