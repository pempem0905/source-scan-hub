# Source Scan Hub — Phase 1 only
# Never commit real secret values.

# External API credentials
APIFY_TOKEN=
BRAVE_SEARCH_API_KEY=

# Shared secret used by Apify workers when calling /api/source-engine/*
SOURCE_WORKER_TOKEN=

# Runtime controls
SOURCE_ENGINE_POWER_MODE=AUTO
SOURCE_ENGINE_GLOBAL_CONCURRENCY=64
SOURCE_ENGINE_PER_DOMAIN_CONCURRENCY=2
SOURCE_ENGINE_RETRY_LIMIT=3
SOURCE_ENGINE_TIMEOUT_MS=15000
SOURCE_ENGINE_DAILY_BUDGET_USD=1
SOURCE_ENGINE_PROJECT_BUDGET_USD=50
BRAVE_REQUESTS_PER_SECOND=5
APIFY_MAX_ACTOR_RUNS=32

# Lovable Cloud / Supabase values are managed by the platform.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
